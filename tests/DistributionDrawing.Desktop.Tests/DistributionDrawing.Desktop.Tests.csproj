<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DistributionDrawing.Application/DistributionDrawing.Application.csproj" />
    <ProjectReference Include="../../src/DistributionDrawing.Desktop/DistributionDrawing.Desktop.csproj" />
    <ProjectReference Include="../../src/DistributionDrawing.Domain/DistributionDrawing.Domain.csproj" />
    <ProjectReference Include="../../src/DistributionDrawing.Infrastructure/DistributionDrawing.Infrastructure.csproj" />
    <ProjectReference Include="../../src/DistributionDrawing.Rendering.Wpf/DistributionDrawing.Rendering.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../src/DistributionDrawing.Desktop/MainWindow.xaml" Link="Acceptance/MainWindow.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/DistributionDrawing.Desktop/MainWindow.TicketRange.cs" Link="Acceptance/MainWindow.TicketRange.cs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/DistributionDrawing.Desktop/MainWindow.xaml.cs" Link="Acceptance/MainWindow.xaml.cs"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/DistributionDrawing.Desktop/WorkTickets/WorkTicketWorkspace.xaml" Link="Acceptance/WorkTicketWorkspace.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/DistributionDrawing.Desktop/WorkTickets/WorkTicketWorkspace.xaml.cs" Link="Acceptance/WorkTicketWorkspace.xaml.cs"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<Window x:Class="DistributionDrawing.Desktop.RingCabinetCreation.RingCabinetCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加环网柜"
        Width="560"
        SizeToContent="Height"
        MinWidth="520"
        MinHeight="400"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20,20,20,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="145" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6,12,12" Text="环网柜名称" />
    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource DialogFieldStyle}"
             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,12,12" Text="线路名称" />
    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource DialogFieldStyle}"
             Text="{Binding LineName, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,12,12" Text="环网柜类型" />
    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource DialogFieldStyle}"
              ItemsSource="{Binding SupportedCabinetTypes}"
              SelectedItem="{Binding CabinetType}" />
    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,12,12" Text="业务间隔数量" />
    <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Style="{StaticResource DialogFieldStyle}"
               Text="{Binding IntervalCountText, UpdateSourceTrigger=PropertyChanged}" />
      <ItemsControl Grid.Column="1" Margin="8,0,0,0"
                    ItemsSource="{Binding CommonIntervalCounts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button MinWidth="38" Margin="4,0,0,0"
                    Padding="6,2" Content="{Binding}"
                    Click="OnUseCommonIntervalCount" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6,12,12" Text="融合间隔接地结构" />
    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" Style="{StaticResource DialogFieldStyle}"
              IsEnabled="{Binding IsPrimarySecondaryIntegrated}"
              ItemsSource="{Binding SupportedGroundingStructures}"
              SelectedItem="{Binding IntegratedGroundingStructureKind}" />
    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4,12,12" Text="PT 间隔" />
    <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,4,0,12"
              IsChecked="{Binding IncludePTInterval}"
              Content="包含 PT 间隔（不包含 DTU）" />
    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4,12,12" Text="PT 位置" />
    <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,4,0,12"
                Orientation="Horizontal" IsEnabled="{Binding IsPTPlacementEnabled}">
      <RadioButton Content="左侧" IsChecked="{Binding IsPTLeft}" />
      <RadioButton Margin="16,0,0,0" Content="右侧" IsChecked="{Binding IsPTRight}" />
    </StackPanel>
    <Border Grid.Row="7" Grid.ColumnSpan="2" Margin="0,4,0,16"
            Padding="12" Background="{StaticResource ShellBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="自动生成的间隔名称" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding GeneratedIntervalNames}" />
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Style="{StaticResource DialogButtonStyle}" Content="确定" IsDefault="True" Click="OnConfirm" />
      <Button Style="{StaticResource DialogButtonStyle}" Margin="8,0,0,0" Content="取消" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>

<Window x:Class="DistributionDrawing.Desktop.RingCabinetCreation.RingCabinetCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加环网柜"
        Width="1220"
        Height="520"
        MinWidth="1040"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="环网柜名称" />
      <TextBox Margin="0,4,0,12"
               Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="55" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="190" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="顺序" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="业务编号" FontWeight="SemiBold" />
        <TextBlock Grid.Column="2" Text="间隔名称" FontWeight="SemiBold" />
        <TextBlock Grid.Column="3" Text="间隔类型" FontWeight="SemiBold" />
        <TextBlock Grid.Column="4" Text="接地结构" FontWeight="SemiBold" />
        <TextBlock Grid.Column="5" Text="操作" FontWeight="SemiBold" />
      </Grid>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Width="100" Content="添加间隔" Click="OnAddInterval" />
          <TextBlock Margin="12,5,0,0"
                     Text="{Binding IntervalCount, StringFormat='当前间隔数：{0}'}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Width="80" Content="确定" IsDefault="True" Click="OnConfirm" />
          <Button Width="80" Margin="8,0,0,0" Content="取消" IsCancel="True" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <Border BorderBrush="#D0D0D0" BorderThickness="1" Padding="6">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Intervals}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="55" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="190" />
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="4,6"
                           Text="{Binding Sequence}" />
                <TextBox Grid.Column="1"
                         Margin="2"
                         Text="{Binding BayIndexText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="2"
                         Margin="2"
                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="3"
                          Margin="2"
                          ItemsSource="{Binding IntervalKinds}"
                          SelectedItem="{Binding IntervalKind}" />
                <ComboBox Grid.Column="4"
                          Margin="2"
                          IsEnabled="{Binding IsIntegratedFeeder}"
                          ItemsSource="{Binding GroundingStructureKinds}"
                          SelectedItem="{Binding GroundingStructureKind}" />
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                  <Button Width="52" Margin="2" Content="上移" Click="OnMoveUp" />
                  <Button Width="52" Margin="2" Content="下移" Click="OnMoveDown" />
                  <Button Width="52" Margin="2" Content="删除" Click="OnRemoveInterval" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>

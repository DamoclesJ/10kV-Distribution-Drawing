<Window x:Class="DistributionDrawing.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:renderingCanvas="clr-namespace:DistributionDrawing.Rendering.Wpf.Canvas;assembly=DistributionDrawing.Rendering.Wpf"
        Title="10kV 配电工作票绘图"
        Icon="Assets/AppIcon.ico"
        Width="1200"
        Height="800"
        MinWidth="1040"
        MinHeight="600"
        Background="{StaticResource ShellBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontSize="{StaticResource Typography.Body}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseDocumentCommand}" />
  </Window.InputBindings>
  <DockPanel>
    <Menu DockPanel.Dock="Top"
          Background="{StaticResource PanelBackgroundBrush}"
          Foreground="{StaticResource TextPrimaryBrush}">
      <MenuItem Header="文件">
        <MenuItem Header="新建" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N" />
        <MenuItem Header="打开" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O" />
        <MenuItem Header="保存" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S" />
        <MenuItem Header="另存为" Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S" />
        <MenuItem Header="关闭当前工程" Command="{Binding CloseDocumentCommand}" InputGestureText="Ctrl+W" />
        <Separator />
        <MenuItem Header="导出 PNG..." Command="{Binding ExportPngCommand}" />
        <Separator />
        <MenuItem Header="退出" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="编辑">
        <MenuItem Header="撤销" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
        <MenuItem Header="重做" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
        <Separator />
        <MenuItem Header="复制" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
        <MenuItem Header="粘贴" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
        <MenuItem Header="全选" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A" />
        <MenuItem Header="删除" Command="{Binding DeleteCommand}" InputGestureText="Delete" />
        <Separator />
        <MenuItem Header="取消当前操作" Command="{Binding CancelCommand}" InputGestureText="Esc" />
      </MenuItem>
      <MenuItem Header="绘图">
        <MenuItem Header="选择" Command="{Binding SelectCommand}" />
        <MenuItem Header="杆塔" Command="{Binding CreatePoleCommand}" />
        <MenuItem Header="环网柜" Command="{Binding CreateRingCabinetCommand}" />
        <MenuItem Header="架空线" Command="{Binding CreateOverheadLineCommand}" />
        <MenuItem Header="电缆" Command="{Binding CreateCableCommand}" />
        <MenuItem Header="电缆终端" Command="{Binding AddCableTerminationCommand}" />
        <MenuItem Header="柱上开关" Command="{Binding AddPoleSwitchCommand}" />
        <MenuItem Header="工作地线" Command="{Binding AddGroundingPointCommand}" />
        <MenuItem Header="工作范围" Command="{Binding AddWorkScopeCommand}" />
      </MenuItem>
      <MenuItem Header="操作">
        <MenuItem Header="开关分/合" Command="{Binding SwitchOperationCommand}" />
        <MenuItem Header="左转 90°" Command="{Binding RotateLeftCommand}" />
        <MenuItem Header="右转 90°" Command="{Binding RotateRightCommand}" />
        <Separator />
        <MenuItem Header="修改电缆起点" Command="{Binding ReconnectCableStartCommand}" />
        <MenuItem Header="修改电缆终点" Command="{Binding ReconnectCableEndCommand}" />
      </MenuItem>
      <MenuItem Header="视图">
        <MenuItem Header="放大" Command="{Binding ZoomInCommand}" />
        <MenuItem Header="缩小" Command="{Binding ZoomOutCommand}" />
        <MenuItem Header="适合图形" Command="{Binding FitDrawingCommand}" />
        <MenuItem Header="显示网格" IsCheckable="True"
                  IsChecked="{Binding GridVisible, Mode=OneWay}" Command="{Binding ToggleGridCommand}" />
        <Separator />
        <MenuItem Header="图面字号设置" Command="{Binding TypographySettingsCommand}" />
      </MenuItem>
    </Menu>

    <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource PanelBackgroundBrush}">
      <ToolBar Background="Transparent" BorderThickness="0" Padding="8,2">
        <Button Style="{StaticResource ToolbarButtonStyle}"
                ToolTip="保存" Command="{Binding SaveProjectCommand}">
          <Path Data="{StaticResource Icon.Save}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
        </Button>
        <Separator Margin="4,3" />
        <Button Style="{StaticResource ToolbarButtonStyle}"
                ToolTip="撤销" Command="{Binding UndoCommand}">
          <Path Data="{StaticResource Icon.Undo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
        </Button>
        <Button Style="{StaticResource ToolbarButtonStyle}"
                ToolTip="重做" Command="{Binding RedoCommand}">
          <Path Data="{StaticResource Icon.Redo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
        </Button>
        <Separator Margin="4,3" />
        <Button Style="{StaticResource ToolbarButtonStyle}"
                ToolTip="复制" Command="{Binding CopyCommand}">
          <Path Data="{StaticResource Icon.Copy}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
        </Button>
        <Button Style="{StaticResource ToolbarButtonStyle}"
                ToolTip="粘贴" Command="{Binding PasteCommand}">
          <Path Data="{StaticResource Icon.Paste}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
        </Button>
        <Button Style="{StaticResource ToolbarButtonStyle}"
                ToolTip="删除" Command="{Binding DeleteCommand}">
          <Path Data="{StaticResource Icon.Delete}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
        </Button>
        <Separator Margin="4,3" />
        <Button Style="{StaticResource ToolbarButtonStyle}"
                ToolTip="适合图形" Command="{Binding FitDrawingCommand}">
          <Path Data="{StaticResource Icon.Fit}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
        </Button>
      </ToolBar>
    </ToolBarTray>

    <StatusBar DockPanel.Dock="Bottom"
               Padding="8,1"
               Background="{StaticResource PanelBackgroundBrush}"
               BorderBrush="{StaticResource BorderBrush}"
               BorderThickness="0,1,0,0"
               Foreground="{StaticResource TextSecondaryBrush}">
      <StatusBarItem HorizontalContentAlignment="Stretch">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Margin="20,0,0,0" Orientation="Horizontal">
            <TextBlock Text="{Binding ZoomText}" />
            <TextBlock Margin="12,0,0,0" Text="{Binding GridText}" />
            <TextBlock Margin="12,0,0,0" Text="{Binding SnapText}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Right" Margin="20,0,0,0" Text="{Binding SelectionStatus}" />
          <TextBlock Text="{Binding StatusText}"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource TextPrimaryBrush}" />
        </DockPanel>
      </StatusBarItem>
    </StatusBar>

    <Grid Background="{StaticResource ShellBackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Padding="10,8"
              Style="{StaticResource ShellPanelStyle}"
              BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <ToggleButton Style="{StaticResource ToolboxItemStyle}"
                          IsChecked="{Binding Toolbox.IsSelectActive, Mode=OneWay}"
                          Command="{Binding SelectCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Margin="0,0,10,0" Data="{StaticResource Icon.Select}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Fill="Transparent"
                      StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" Text="选择" />
              </StackPanel>
            </ToggleButton>
            <TextBlock Style="{StaticResource ToolboxSectionStyle}" Text="设备" />
            <ToggleButton Style="{StaticResource ToolboxItemStyle}"
                          IsChecked="{Binding Toolbox.IsPoleActive, Mode=OneWay}"
                          Command="{Binding CreatePoleCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Margin="0,0,10,0" Data="{StaticResource Icon.Pole}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" Text="杆塔" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolboxItemStyle}"
                          IsChecked="{Binding Toolbox.IsRingCabinetActive, Mode=OneWay}"
                          Command="{Binding CreateRingCabinetCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Margin="0,0,10,0" Data="{StaticResource Icon.RingCabinet}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" Text="环网柜" />
              </StackPanel>
            </ToggleButton>
            <TextBlock Style="{StaticResource ToolboxSectionStyle}" Text="连接" />
            <ToggleButton Style="{StaticResource ToolboxItemStyle}"
                          IsChecked="{Binding Toolbox.IsOverheadLineActive, Mode=OneWay}"
                          Command="{Binding CreateOverheadLineCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Margin="0,0,10,0" Data="{StaticResource Icon.OverheadLine}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" Text="架空线" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolboxItemStyle}"
                          IsChecked="{Binding Toolbox.IsCableActive, Mode=OneWay}"
                          Command="{Binding CreateCableCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Margin="0,0,10,0" Data="{StaticResource Icon.Cable}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" Text="电缆" />
              </StackPanel>
            </ToggleButton>
            <TextBlock Style="{StaticResource ToolboxSectionStyle}" Text="附件" />
            <ToggleButton Style="{StaticResource ToolboxItemStyle}"
                          IsChecked="{Binding Toolbox.IsCableTerminationActive, Mode=OneWay}"
                          Command="{Binding AddCableTerminationCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Margin="0,0,10,0" Data="{StaticResource Icon.CableTermination}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" Text="电缆终端" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolboxItemStyle}"
                          IsChecked="{Binding Toolbox.IsPoleSwitchActive, Mode=OneWay}"
                          Command="{Binding AddPoleSwitchCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Margin="0,0,10,0" Data="{StaticResource Icon.PoleSwitch}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" Text="柱上开关" />
              </StackPanel>
            </ToggleButton>
            <TextBlock Style="{StaticResource ToolboxSectionStyle}" Text="作业" />
            <ToggleButton Style="{StaticResource ToolboxItemStyle}"
                          IsChecked="{Binding Toolbox.IsGroundingPointActive, Mode=OneWay}"
                          Command="{Binding AddGroundingPointCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Margin="0,0,10,0" Data="{StaticResource Icon.WorkGrounding}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" Text="工作地线" />
              </StackPanel>
            </ToggleButton>
            <ToggleButton Style="{StaticResource ToolboxItemStyle}"
                          IsChecked="{Binding Toolbox.IsWorkScopeActive, Mode=OneWay}"
                          Command="{Binding AddWorkScopeCommand}">
              <StackPanel Orientation="Horizontal">
                <Path Width="18" Height="18" Margin="0,0,10,0" Data="{StaticResource Icon.WorkScope}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                      StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform" />
                <TextBlock VerticalAlignment="Center" Text="工作范围" />
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="1"
              Margin="12,8"
              Background="{StaticResource CanvasBackgroundBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1">
        <DockPanel>
          <TabControl x:Name="DocumentTabs"
                      DockPanel.Dock="Top"
                      Height="34"
                      Background="{StaticResource PanelBackgroundBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="0,0,0,1"
                      ItemContainerStyle="{StaticResource DocumentTabStyle}"
                      SelectionChanged="OnDocumentTabSelectionChanged">
            <TabControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding TabTitle}"
                           ToolTip="{Binding FilePath}"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </TabControl.ItemTemplate>
          </TabControl>
          <Grid Background="{StaticResource CanvasBackgroundBrush}">
            <renderingCanvas:DrawingVisualHost x:Name="DrawingSurface"
                                           MouseDown="OnDrawingSurfaceMouseDown"
                                           MouseLeftButtonDown="OnDrawingSurfaceMouseLeftButtonDown"
                                           MouseRightButtonDown="OnDrawingSurfaceMouseRightButtonDown"
                                           MouseMove="OnDrawingSurfaceMouseMove"
                                           MouseLeftButtonUp="OnDrawingSurfaceMouseLeftButtonUp"
                                           MouseUp="OnDrawingSurfaceMouseUp"
                                           PreviewMouseWheel="OnDrawingSurfaceMouseWheel"
                                           LostMouseCapture="OnDrawingSurfaceLostMouseCapture"
                                             SizeChanged="OnDrawingSurfaceSizeChanged" />
            <Border Padding="32"
                    Background="{StaticResource CanvasBackgroundBrush}"
                    Panel.ZIndex="10">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWorkspaceEmpty}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="10kV 配电工作票绘图" />
                <TextBlock Margin="0,8,0,20"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="创建或打开工程后开始绘图" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                  <Button MinWidth="104" Height="34" Padding="14,0"
                          Content="新建工程" Command="{Binding NewProjectCommand}" />
                  <Button MinWidth="104" Height="34" Margin="8,0,0,0" Padding="14,0"
                          Content="打开工程" Command="{Binding OpenProjectCommand}" />
                </StackPanel>
                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           FontSize="{StaticResource Typography.Secondary}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Ctrl+N 新建  ·  Ctrl+O 打开" />
              </StackPanel>
            </Border>
            <TextBlock Panel.ZIndex="5"
                       Margin="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="从左侧工具箱选择杆塔或环网柜开始绘图">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Setter Property="Opacity" Value="0.72" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDrawingEmpty}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </DockPanel>
      </Border>

      <Border x:Name="PropertyInspectorPanel"
              Grid.Column="2"
              Padding="12,10"
              Style="{StaticResource ShellPanelStyle}"
              BorderThickness="1,0,0,0">
        <Border.Resources>
          <Style TargetType="TextBox" BasedOn="{StaticResource InspectorEditorStyle}" />
          <Style TargetType="ComboBox" BasedOn="{StaticResource InspectorEditorStyle}" />
          <Style TargetType="Button" BasedOn="{StaticResource InspectorButtonStyle}" />
        </Border.Resources>
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     FontSize="{StaticResource Typography.Title}"
                     FontWeight="SemiBold"
                     Text="{Binding ObjectType}" />
          <TextBlock DockPanel.Dock="Top"
                     Margin="0,4,0,10"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="{Binding ObjectTitle}"
                     TextWrapping="Wrap" />
          <StackPanel x:Name="RingCabinetEditorPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Style="{StaticResource InspectorLabelStyle}" Text="环网柜名称" />
            <TextBox x:Name="RingCabinetDisplayNameInput" Margin="0,4,0,4" />
            <Button Content="应用环网柜名称"
                    Click="OnApplyRingCabinetDisplayName" />
            <TextBlock Style="{StaticResource InspectorLabelStyle}" Text="线路名称" />
            <TextBox x:Name="RingCabinetLineNameInput" Margin="0,4,0,4" />
            <Button Content="应用线路名称"
                    Click="OnApplyRingCabinetLineName" />
          </StackPanel>
          <StackPanel x:Name="IntervalEditorPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="间隔名称" />
            <TextBox x:Name="IntervalDisplayNameInput"
                     Margin="0,4,0,4" />
            <Button Margin="0,0,0,8"
                    Content="应用间隔名称"
                    Click="OnApplyIntervalDisplayName" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="间隔类型" />
            <ComboBox x:Name="IntervalTypeInput"
                      SelectionChanged="OnIntervalTypeSelectionChanged"
                      Margin="0,4,0,4" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="接地结构（一二次融合间隔）" />
            <ComboBox x:Name="IntervalGroundingStructureInput"
                      Margin="0,4,0,4" />
            <Button Content="应用间隔配置"
                    Click="OnApplyIntervalConfiguration" />
          </StackPanel>
          <StackPanel x:Name="SwitchOperationPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="开关操作" />
            <TextBlock x:Name="SwitchOperationStateText"
                       Margin="0,4,0,4"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <Button x:Name="SwitchOperationButton"
                    Command="{Binding DataContext.SwitchOperationCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
          </StackPanel>
          <StackPanel x:Name="PoleNumberEditorPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="杆号" />
            <TextBox x:Name="PoleNumberInput"
                     Margin="0,4,0,4" />
            <Button Content="应用杆号"
                    Click="OnApplyPoleNumber" />
          </StackPanel>
          <StackPanel x:Name="PoleInstalledDevicesPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Style="{StaticResource InspectorLabelStyle}" Text="杆塔安装设备" />
            <TextBlock x:Name="PoleInstalledDevicesText"
                       Margin="0,4,0,4"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <ListBox x:Name="PoleInstalledDevicesList"
                     Margin="0,2,0,4"
                     DisplayMemberPath="DisplayText"
                     SelectionChanged="OnPoleInstalledDeviceSelected" />
            <Button Content="左转 90°"
                    Command="{Binding DataContext.RotateLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Margin="0,2,0,0" Content="右转 90°"
                    Command="{Binding DataContext.RotateRightCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Margin="0,2,0,0" Content="删除选中安装设备" Click="OnRemovePoleAttachment" />
          </StackPanel>
          <StackPanel x:Name="CablePropertyEditorPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="电缆属性" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="电缆型号" />
            <TextBox x:Name="CableTypeInput"
                     Margin="0,2,0,2" />
            <Button Content="应用型号"
                    Click="OnApplyCableType" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="长度（m）" />
            <TextBox x:Name="CableLengthInput"
                     Margin="0,2,0,2" />
            <Button Content="应用长度"
                    Click="OnApplyCableLength" />
            <Button Margin="0,4,0,0"
                    Content="修改起点"
                    Command="{Binding DataContext.ReconnectCableStartCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Margin="0,2,0,0"
                    Content="修改终点"
                    Command="{Binding DataContext.ReconnectCableEndCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Margin="0,2,0,0"
                    Content="取消端点修改"
                    Click="OnCancelCableReconnect" />
          </StackPanel>
          <StackPanel x:Name="AttachmentOffsetEditorPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="附属设备相对位置（mm）" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="水平偏移 X" />
            <TextBox x:Name="AttachmentOffsetXInput"
                     Margin="0,2,0,2" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="垂直偏移 Y" />
            <TextBox x:Name="AttachmentOffsetYInput"
                     Margin="0,2,0,4" />
            <Button Content="应用位置"
                    Click="OnApplyAttachmentOffset" />
          </StackPanel>
          <StackPanel x:Name="AttachmentLayoutEditorPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="附属设备布局" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="宽度 (mm)" />
            <TextBox x:Name="AttachmentWidthInput"
                     Margin="0,2,0,2" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="高度 (mm)" />
            <TextBox x:Name="AttachmentHeightInput"
                     Margin="0,2,0,2" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="标签水平偏移 (mm)" />
            <TextBox x:Name="AttachmentLabelOffsetXInput"
                     Margin="0,2,0,2" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="标签垂直偏移 (mm)" />
            <TextBox x:Name="AttachmentLabelOffsetYInput"
                     Margin="0,2,0,4" />
            <Button Content="应用布局"
                    Click="OnApplyAttachmentLayout" />
          </StackPanel>
          <StackPanel x:Name="CableTerminationDisplayNameEditorPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="电缆终端名称" />
            <TextBox x:Name="CableTerminationDisplayNameInput"
                     Margin="0,4,0,4" />
            <Button Content="应用名称"
                    Click="OnApplyCableTerminationDisplayName" />
          </StackPanel>
          <StackPanel x:Name="GroundingPointEditorPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="工作地线编辑" />
            <TextBlock x:Name="GroundingPointTerminalText"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="位置说明" />
            <TextBox x:Name="GroundingPointLocationInput"
                     Margin="0,2,0,2" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="编号" />
            <TextBox x:Name="GroundingPointNumberInput"
                     Margin="0,2,0,2" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="备注" />
            <TextBox x:Name="GroundingPointNoteInput"
                     Margin="0,2,0,4" />
            <WrapPanel>
              <Button Content="应用工作地线"
                      Margin="0,0,4,0"
                      Click="OnApplyGroundingPoint" />
              <Button Content="删除工作地线"
                      Click="OnRemoveGroundingPoint" />
            </WrapPanel>
          </StackPanel>
          <StackPanel x:Name="WorkScopeCreationPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="添加工作范围" />
            <TextBlock x:Name="WorkScopePickStateText"
                       Margin="0,4,0,4"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="边界 A" />
            <TextBlock x:Name="WorkScopeBoundaryAText"
                       Margin="0,2,0,2"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="边界 A 侧别（人工输入）" />
            <TextBox x:Name="WorkScopeBoundaryASideInput"
                     Margin="0,2,0,2"
                     ToolTip="请输入边界 A 的侧别" />
            <Button Content="确认边界 A"
                    Margin="0,0,0,4"
                    Click="OnConfirmWorkScopeBoundaryA" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="边界 B" />
            <TextBlock x:Name="WorkScopeBoundaryBText"
                       Margin="0,2,0,2"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="边界 B 侧别（人工输入）" />
            <TextBox x:Name="WorkScopeBoundaryBSideInput"
                     Margin="0,2,0,2"
                     ToolTip="请输入边界 B 的侧别" />
            <Button Content="确认边界 B"
                    Margin="0,0,0,4"
                    Click="OnConfirmWorkScopeBoundaryB" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="说明" />
            <TextBox x:Name="WorkScopeDescriptionInput"
                     Margin="0,2,0,2" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="高级关联：工作地线 ID（兼容输入）" />
            <TextBox x:Name="WorkScopeGroundingPointIdsInput"
                     Margin="0,2,0,4"
                     ToolTip="当前版本使用稳定 ID 关联已有工作地线"
                     TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="创建工作范围"
                      Margin="0,0,4,0"
                      Click="OnApplyWorkScope" />
              <Button Content="取消"
                      Click="OnCancelWorkScope" />
            </WrapPanel>
          </StackPanel>
          <StackPanel x:Name="WorkScopeEditorPanel"
                      DockPanel.Dock="Top"
                      Margin="0,0,0,10"
                      Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="工作范围编辑" />
            <TextBlock x:Name="WorkScopeEditorBoundaryText"
                       Margin="0,4,0,4"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="说明" />
            <TextBox x:Name="WorkScopeEditorDescriptionInput"
                     Margin="0,2,0,2" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       Text="高级关联：工作地线 ID（兼容输入）" />
            <TextBox x:Name="WorkScopeEditorGroundingPointIdsInput"
                     Margin="0,2,0,4"
                     ToolTip="当前版本使用稳定 ID 关联已有工作地线"
                     TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="应用工作范围"
                      Margin="0,0,4,0"
                      Click="OnApplyWorkScope" />
              <Button Content="删除工作范围"
                      Click="OnRemoveWorkScope" />
            </WrapPanel>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Expander Header="{Binding Title}"
                            Style="{StaticResource InspectorExpanderStyle}"
                            IsExpanded="True"
                            Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding Properties}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,3,0,5">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="2*" />
                              <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Margin="0,0,8,0"
                                       FontSize="{StaticResource Typography.Secondary}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding DisplayName}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding DisplayValue}"
                                       TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>

<Window x:Class="DistributionDrawing.Desktop.PoleSwitchCreation.PoleSwitchCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加柱上开关"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16">
    <TextBlock Text="开关类型" />
    <ComboBox x:Name="SwitchKindInput" Margin="0,6,0,12" MinWidth="220" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="确定" Width="72" Margin="0,0,8,0" Click="OnConfirm" />
      <Button Content="取消" Width="72" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>

<Window x:Class="DistributionDrawing.Desktop.CableConnection.CableCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="电缆参数"
        Width="360"
        SizeToContent="Height"
        Style="{StaticResource DialogWindowStyle}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <StackPanel Margin="16,16,16,20">
    <TextBlock Text="电缆型号" />
    <TextBox x:Name="CableTypeInput" Margin="0,4,0,12" Style="{StaticResource DialogFieldStyle}" />
    <TextBlock Text="长度（米）" />
    <TextBox x:Name="LengthInput" Margin="0,4,0,16" Style="{StaticResource DialogFieldStyle}" />
    <WrapPanel HorizontalAlignment="Right">
      <Button Margin="0,0,8,0" Style="{StaticResource DialogButtonStyle}" Content="确定" Click="OnConfirm" />
      <Button Style="{StaticResource DialogButtonStyle}" Content="取消" IsCancel="True" />
    </WrapPanel>
  </StackPanel>
</Window>

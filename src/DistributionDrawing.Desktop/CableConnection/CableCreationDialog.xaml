<Window x:Class="DistributionDrawing.Desktop.CableConnection.CableCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="电缆参数"
        Width="360"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <StackPanel Margin="16">
    <TextBlock Text="电缆型号" />
    <TextBox x:Name="CableTypeInput" Margin="0,4,0,10" />
    <TextBlock Text="长度（米）" />
    <TextBox x:Name="LengthInput" Margin="0,4,0,14" />
    <WrapPanel HorizontalAlignment="Right">
      <Button Width="72" Margin="0,0,8,0" Content="确定" Click="OnConfirm" />
      <Button Width="72" Content="取消" IsCancel="True" />
    </WrapPanel>
  </StackPanel>
</Window>

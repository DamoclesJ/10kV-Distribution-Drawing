<Window x:Class="DistributionDrawing.Desktop.CableTerminationCreation.CableTerminationCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加电缆终端"
        Width="420"
        SizeToContent="Height"
        Style="{StaticResource DialogWindowStyle}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16,16,16,20">
    <StackPanel DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button Style="{StaticResource DialogButtonStyle}"
              Content="确定"
              IsDefault="True"
              Click="OnConfirm" />
      <Button Style="{StaticResource DialogButtonStyle}"
              Margin="8,0,0,0"
              Content="取消"
              IsCancel="True" />
    </StackPanel>

    <StackPanel>
      <TextBlock Text="显示名称" />
      <TextBox x:Name="DisplayNameInput"
               Margin="0,4,0,0"
               Style="{StaticResource DialogFieldStyle}" />
    </StackPanel>
  </DockPanel>
</Window>
